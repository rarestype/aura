#!/bin/bash
set -euo pipefail

swift --version

# 1. Build tests and release targets in a single compilation pass
swift build -c release --build-tests -Xswiftc -enable-testing

# 2. Fast unit tests in release mode (~3s)
swift test -c release --skip-build

# 3. Full detail 3 computation and golden reference verification
threads=$(\
    nproc 2>/dev/null || \
    sysctl -n hw.logicalcpu 2>/dev/null || \
    getconf _NPROCESSORS_ONLN 2>/dev/null || \
    echo 4 \
)

echo "Running golden reference tests with ${threads} threads..."

.build/release/AuraGoldenTests --threads "$threads"
